function loadUserPatterns() {
  try {
    var stored = localStorage.getItem('pattern_ai_user_patterns');
    if (stored) userPatterns = JSON.parse(stored);
    var storedAbstract = localStorage.getItem('pattern_ai_abstract_patterns');
    if (storedAbstract) abstractPatterns = JSON.parse(storedAbstract);
  } catch (e) { userPatterns = []; abstractPatterns = []; }
  updateMemoryDisplay();
}

function deleteUserPattern(pattern) {
  userPatterns = userPatterns.filter(function(p) { return p !== pattern; });
  try { localStorage.setItem('pattern_ai_user_patterns', JSON.stringify(userPatterns)); updateMemoryDisplay(); } catch (e) {}
}

function deleteAbstractPattern(rule) {
  abstractPatterns = abstractPatterns.filter(function(p) { return p.rule !== rule; });
  try { localStorage.setItem('pattern_ai_abstract_patterns', JSON.stringify(abstractPatterns)); updateMemoryDisplay(); } catch (e) {}
}

