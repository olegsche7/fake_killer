function updateWeightsInfo() {
  var dom = DOMAINS[currentDomain]; if (!dom) return;
  var listEl = document.getElementById('weights-list');
  var html = '';
  for (var i = 0; i < CRITERIA.length; i++) html += '<div>' + CRITERIA[i].n + ': <strong>' + (dom.weights[i] * 100).toFixed(0) + '%</strong></div>';
  listEl.innerHTML = html;
}

function resetWeights() {
  var dom = DOMAINS[currentDomain]; if (!dom) return;
  for (var i = 0; i < 10; i++) {
    vals[i] = 0.5; originalVals[i] = 0.5;
    var slider = document.getElementById('slider' + i); if (slider) slider.value = 0.5;
    var valEl = document.getElementById('v' + i); if (valEl) valEl.textContent = '0.50';
  }
  applyDomainWeights();
  logToScreen('&#128260; Веса сброшены', 'success');
  if (document.getElementById('res').style.display === 'block') runEvaluate();
}

function applyDomainWeights() {
  var dom = DOMAINS[currentDomain]; if (!dom) return;
  for (var i = 0; i < 10; i++) {
    CRITERIA[i].w = dom.weights[i]; CRITERIA[i].d = dom.descriptions[i];
    var nameEl = document.getElementById('cname'+i);
    var descEl = document.getElementById('cdesc'+i);
    if (nameEl) nameEl.innerHTML = CRITERIA[i].n + ' <span style="color:#666;font-size:11px">(вес: '+dom.weights[i]+')</span>';
    if (descEl) descEl.textContent = dom.descriptions[i];
  }
}

function changeVal(i, value) {
  vals[i] = parseFloat(value);
  var valEl = document.getElementById('v' + i);
  if (valEl) valEl.textContent = vals[i].toFixed(2);
  if (vals[i] !== originalVals[i]) {
    if (valEl) valEl.classList.add('changed');
    var slider = document.getElementById('slider' + i);
    if (slider) slider.classList.add('changed');
  }
}

// === МАТЕМАТИЧЕСКИЕ ФУНКЦИИ (НЕ ТРОГАТЬ) ===
function cosineSimilarity(vecA, vecB, weights) {
  var dot=0, magA=0, magB=0;
  for(var i=0; i<vecA.length; i++) { var w=weights[i]||1, a=vecA[i]*w, b=vecB[i]*w; dot+=a*b; magA+=a*a; magB+=b*b; }
  return (magA===0 || magB===0) ? 0 : dot / (Math.sqrt(magA)*Math.sqrt(magB));
}
function normalizedEuclideanDistance(vecA, vecB, weights) {
  var sum=0, max=0;
  for(var i=0; i<vecA.length; i++) { var w=weights[i]||1, d=(vecA[i]-vecB[i])*w; sum+=d*d; max+=w*w; }
  return Math.sqrt(sum) / Math.sqrt(max);
}
function combinedScore(vecA, vecB, weights) {
  var cs = cosineSimilarity(vecA, vecB, weights), ed = normalizedEuclideanDistance(vecA, vecB, weights);
  return { combined: 0.6*cs + 0.4*(1-ed), cosine: cs, euclidean: 1-ed };
}
function sigmoid(x) { return 1 / (1 + Math.exp(-6 * (x - 0.5))); }
function calculateNonlinearScore(vals, weights) {
  var base = 0; for(var i=0; i<vals.length; i++) base += vals[i]*weights[i];
  var score = sigmoid(base), penalty = 1.0;
  [[3,0], [3,8], [1,7]].forEach(function(p) { if(vals[p[0]]<0.3 && vals[p[1]]<0.3) penalty *= 0.7; });
  return score * penalty;
}
// === КОНЕЦ МАТЕМАТИЧЕСКИХ ФУНКЦИЙ ===

function detectHallucinations(text) {
  var lower = text.toLowerCase(), found = [];
  for(var cat in HALLUCINATION_MARKERS) {
    HALLUCINATION_MARKERS[cat].forEach(function(m) { if(lower.indexOf(m) !== -1) found.push({category: cat, marker: m}); });
  }
  return found;
}
function detectContradictions(text) {
  var lower = text.toLowerCase(), pos=[], neg=[];
  CONTRADICTION_PAIRS.forEach(function(p) {
    p.pos.forEach(function(w) { if(lower.indexOf(w) !== -1) pos.push(w); });
    p.neg.forEach(function(w) { if(lower.indexOf(w) !== -1) neg.push(w); });
  });
  return (pos.length > 0 && neg.length > 0) ? { found: true, message: 'Позитивная самооценка (' + pos.slice(0,3).join(', ') + ') противоречит фактам (' + neg.slice(0,3).join(', ') + ').' } : { found: false };
}
function detectFluff(text) { var lower = text.toLowerCase(); return FLUFF_MARKERS.filter(function(m) { return lower.indexOf(m) !== -1; }); }
function detectDomain(text) {
  var lower = text.toLowerCase(), score = 0;
  ["протокол","метод","исследование","cell","nature","дудн","шарпантье","crispr","ген","сомнолог","нейро","квантов"].forEach(function(w) { if(lower.indexOf(w) !== -1) score += 3; });
  if (score >= 6) return 'science';
  var best = 'health', max = 0;
  for(var k in DOMAINS) {
    var s = 0; DOMAINS[k].keywords.forEach(function(kw) { kw.pos.forEach(function(w) { if(lower.indexOf(w)!==-1) s++; }); kw.neg.forEach(function(w) { if(lower.indexOf(w)!==-1) s++; }); });
    if(s > max) { max = s; best = k; }
  }
  return max < 3 ? (lower.indexOf("бизнес")!==-1 ? 'business' : 'health') : best;
}
function extractEntities(text) {
  var entities = [];
  [/протокол\s+[А-Я][а-я]+/i, /метод\s+[А-Я][а-я]+/i, /[А-Я]{2,}-[А-Я]{2,}/].forEach(function(p) {
    var m = text.match(p); if(m) m.forEach(function(x) { entities.push(x); });
  });
  return entities.slice(0, 5);
}
function detectUserPatterns(text) {
  var lower = text.toLowerCase(), found = [];
  userPatterns.forEach(function(p) { if(lower.indexOf(p.toLowerCase()) !== -1) found.push({category: 'user_memory', marker: p}); });
  abstractPatterns.forEach(function(ap) {
    var match = ap.rule.toLowerCase().split(/\s+/).filter(function(w) { return w.length > 3 && lower.indexOf(w) !== -1; }).length;
    if(match >= 2) found.push({category: 'abstract_pattern', marker: ap.rule + ' (' + ap.category + ')'});
  });
  return found;
}

function displayAbstractPatterns(patterns) {
  var html = '';
  patterns.forEach(function(p, idx) {
    var isSaved = abstractPatterns.find(function(ap) { return ap.rule === p.rule; });
    html += '<div class="pattern-item"><span>&#128309; ' + p.rule + ' <span style="color:#888;font-size:10px;">(' + p.category + ')</span><br><span style="color:#ccc;font-size:11px;">' + (p.description || '') + '</span></span>';
    if (isSaved) {
      html += '<span style="color:#4CAF50;font-size:11px;">&#9989; Сохранено</span>';
    } else {
      var saveIdx = pendingPatterns.indexOf(p);
      if (saveIdx === -1) {
        pendingPatterns.push(p);
        saveIdx = pendingPatterns.length - 1;
      }
      html += '<button class="save-btn" onclick="handleSavePattern(' + saveIdx + ')">&#128190; Сохранить</button>';
    }
    html += '</div>';
  });
  return html;
}

function handleSavePattern(idx) {
  if (idx < 0 || idx >= pendingPatterns.length) return;
  var p = pendingPatterns[idx];
  var result = saveAbstractPattern(p);
  if (result) {
    logToScreen('&#128190; Паттерн сохранён: ' + p.rule, 'success');
  } else {
    logToScreen('&#9888;&#65039; Паттерн уже сохранён', 'info');
  }
  refreshAbstractPatternsDisplay();
}

function refreshAbstractPatternsDisplay() {
  if (llmResult && llmResult.abstract_patterns && llmResult.abstract_patterns.length > 0) {
    document.getElementById('llm-abstract-patterns').innerHTML = displayAbstractPatterns(llmResult.abstract_patterns);
  }
}

function displayMetaPatterns(metaPatterns) {
  if(!metaPatterns || metaPatterns.length === 0) return '';
  var html = '', seen = {};
  metaPatterns.forEach(function(p) {
    var key = p.name || p.description || ''; if(seen[key]) return; seen[key] = true;
    var icon = p.severity === 'critical' ? '&#128308;' : (p.severity === 'warning' ? '&#128992;' : '');
    html += '<div class="meta-pattern-item meta-severity-' + p.severity + '"><div class="meta-pattern-name">' + icon + ' ' + p.name + '</div><div class="meta-pattern-desc">' + p.description + '</div><div class="meta-pattern-rec">&#128161; ' + p.recommendation + '</div></div>';
  });
  return html;
}

function displayDebate(debate) {
  if(!debate) return ''; var html = '';
  if(debate.prosecutor) {
    var c = debate.prosecutor.contradictions || [], s = debate.prosecutor.suspicious_claims || [], m = debate.prosecutor.manipulative_language || [];
    if(c.length > 0 || s.length > 0 || m.length > 0) {
      html += '<div class="debate-argument pro"><div class="debate-label">&#9878;&#65039; Обвинитель:</div><div class="debate-text">';
      if(c.length > 0) html += '<strong>Противоречия:</strong> ' + c.join('; ') + '<br>';
      if(s.length > 0) html += '<strong>Подозрительное:</strong> ' + s.join('; ') + '<br>';
      if(m.length > 0) html += '<strong>Манипуляции:</strong> ' + m.join('; ');
      html += '</div></div>';
    }
  }
  if(debate.defender && debate.defender.defense_arguments && debate.defender.defense_arguments.length > 0) {
    html += '<div class="debate-argument con"><div class="debate-label">&#128737;&#65039; Защитник:</div><div class="debate-text">' + debate.defender.defense_arguments.join('; ') + '</div></div>';
  }
  if(debate.judge) {
    var verdictText = debate.judge.verdict, icon = '&#9878;&#65039;';
    if (currentMode === 'resume') {
      if (verdictText === 'hire') { verdictText = 'ПРИНЯТЬ'; icon = '&#9989;'; }
      else if (verdictText === 'reject') { verdictText = 'ОТКЛОНИТЬ'; icon = '&#128308;'; }
      else { verdictText = 'ПРОВЕРИТЬ'; icon = '&#128992;'; }
    } else {
      if (verdictText === 'real') { verdictText = 'REAL'; icon = '&#9989;'; }
      else if (verdictText === 'fake') { verdictText = 'FAKE'; icon = '&#128308;'; }
      else { verdictText = 'UNCERTAIN'; icon = '&#9888;&#65039;'; }
    }
    html += '<div class="debate-argument" style="border-left-color: #9c27b0;"><div class="debate-label">&#9878;&#65039; Вердикт:</div><div class="debate-text"><strong>' + icon + ' ' + verdictText + '</strong> — ' + (debate.judge.reasoning || '') + '</div></div>';
  }
  return html;
}

function displayQuestions(questions) {
  if(!questions || questions.length === 0) return '';
  var html = '';
  questions.forEach(function(q, idx) {
    html += '<div class="question-item"><div class="question-number">Вопрос ' + (idx+1) + '</div><div class="question-text">' + q.question + '</div>';
    if (q.target) html += '<div class="question-target">&#127919; Проверяем: ' + q.target + '</div>';
    html += '</div>';
  });
  return html;
}

function displayConcreteness(data) {
  var html = '<div class="concreteness-item">';
  html += '<div style="font-size:16px; font-weight:bold; margin-bottom:8px;">' + data.styleIcon + ' ' + data.styleVerdict + '</div>';
  html += '<div style="color:#ccc; font-size:13px; margin-bottom:12px;">' + data.styleDesc + '</div>';
  html += '<div style="display:flex; gap:20px; flex-wrap:wrap;">';
  html += '<div><strong style="color:#F44336;">Абстракции:</strong> ' + data.fluffCount + '</div>';
  html += '<div><strong style="color:#4CAF50;">Конкретика:</strong> ' + data.concreteCount + '</div>';
  html += '</div>';
  if (data.foundFluff && data.foundFluff.length > 0) html += '<div style="margin-top:8px; font-size:12px; color:#ff9800;">Клише: ' + data.foundFluff.join(', ') + '</div>';
  if (data.foundConcrete && data.foundConcrete.length > 0) html += '<div style="margin-top:4px; font-size:12px; color:#4CAF50;">Факты: ' + data.foundConcrete.join(', ') + '</div>';
  if (currentMode === 'resume' && data.fluffCount >= 4 && data.concreteCount <= 2) {
    html += '<div style="margin-top:12px; padding:8px; background:rgba(244,67,54,0.1); border-radius:6px; font-size:12px; color:#F44336;">&#128161; <strong>HR:</strong> Используйте STAR-методику. Требуйте конкретных примеров (Situation, Task, Action, Result).</div>';
  }
  html += '</div>';
  return html;
}

function displaySecurityFindings(findings) {
  if (!Array.isArray(findings) || findings.length === 0) return '';
  var html = '';
  var critical = findings.filter(function(f) { return f.severity === 'critical'; }).length;
  var high = findings.filter(function(f) { return f.severity === 'high'; }).length;
  var medium = findings.filter(function(f) { return f.severity === 'medium'; }).length;
  var low = findings.filter(function(f) { return f.severity === 'low'; }).length;
  
  html += '<div style="margin-bottom:15px; padding:10px; background:rgba(0,0,0,0.2); border-radius:6px;">';
  html += '<strong>&#128202; Карта поверхности атаки:</strong> Обнаружено уязвимостей: ' + findings.length + '<br>';
  html += '&#128308; Критических: ' + critical + ' | &#128992; Высоких: ' + high + ' | &#128993; Средних: ' + medium + ' | &#128994; Низких: ' + low;
  html += '</div>';
  
  findings.forEach(function(f, idx) {
    var severityClass = f.severity || 'medium';
    var severityIcon = f.severity === 'critical' ? '&#128308;' : (f.severity === 'high' ? '&#128992;' : (f.severity === 'medium' ? '&#128993;' : '&#128994;'));
    var typeLabel = (f.type || 'unknown').replace(/_/g, ' ').replace(/\b\w/g, function(c) { return c.toUpperCase(); });
    
    html += '<div class="security-finding ' + severityClass + '">';
    html += '<div class="security-finding-title">' + severityIcon + ' [' + (f.severity || 'unknown').toUpperCase() + '] ' + typeLabel + '</div>';
    html += '<div class="security-finding-field"><strong>Описание:</strong> ' + (f.description || 'нет описания') + '</div>';
    html += '<div class="security-finding-field"><strong>&#9876;&#65039; Вектор атаки:</strong> ' + (f.attack_vector || 'не определён') + '</div>';
    html += '<div class="security-finding-field"><strong>&#128203; OWASP:</strong> ' + (f.owasp_category || 'N/A') + '</div>';
    html += '<div class="security-finding-field"><strong>&#128295; Исправление:</strong> ' + (f.remediation || 'не указано') + '</div>';
    if (f.real_world_analogy && f.real_world_analogy !== 'нет аналога') {
      html += '<div class="security-finding-field"><strong>&#128218; Аналогия:</strong> ' + f.real_world_analogy + '</div>';
    }
    html += '</div>';
  });
  
  html += '<div style="margin-top:15px; padding:10px; background:rgba(0,0,0,0.2); border-radius:6px;">';
  html += '<strong>&#128203; Нарушения стандартов:</strong><br>';
  var owaspCats = findings.map(function(f) { return f.owasp_category; }).filter(function(c) { return c && c !== 'N/A'; });
  if (owaspCats.length > 0) {
    var uniqueOwasp = owaspCats.filter(function(item, pos) { return owaspCats.indexOf(item) === pos; });
    html += 'OWASP Top 10 2021:<br>';
    uniqueOwasp.forEach(function(cat) { html += '  &#8226; ' + cat + '<br>'; });
  } else {
    html += 'Явные нарушения OWASP Top 10 не выявлены (но это не гарантирует безопасность).<br>';
  }
  html += '<br><strong>Принципы безопасности под угрозой:</strong><br>';
  html += '  &#8226; Least Privilege (наименьшие привилегии)<br>';
  html += '  &#8226; Defense in Depth (многоуровневая защита)<br>';
  html += '  &#8226; Auditability (возможность аудита)<br>';
  html += '  &#8226; Fail-Safe Defaults (безопасные настройки по умолчанию)';
  html += '</div>';
  
  html += '<div style="margin-top:15px; padding:10px; background:rgba(0,0,0,0.2); border-radius:6px;">';
  html += '<strong>&#128295; План исправления (Remediation Plan):</strong><br><br>';
  html += '<strong>ПРИОРИТЕТ 1 (КРИТИЧНО — исправить немедленно):</strong><br>';
  var criticalFindings = findings.filter(function(f) { return f.severity === 'critical'; });
  if (criticalFindings.length > 0) {
    criticalFindings.forEach(function(f, idx) {
      html += '  ' + (idx + 1) + '. ' + (f.type || '').replace(/_/g, ' ') + ' &#8594; ' + (f.remediation || 'требует анализа') + '<br>';
    });
  } else {
    html += '  (нет критических уязвимостей)<br>';
  }
  html += '<br><strong>ПРИОРИТЕТ 2 (ВЫСОКИЙ — исправить в течение недели):</strong><br>';
  var highFindings = findings.filter(function(f) { return f.severity === 'high'; });
  if (highFindings.length > 0) {
    highFindings.forEach(function(f, idx) {
      html += '  ' + (idx + 1) + '. ' + (f.type || '').replace(/_/g, ' ') + ' &#8594; ' + (f.remediation || 'требует анализа') + '<br>';
    });
  } else {
    html += '  (нет высоких уязвимостей)<br>';
  }
  html += '<br><strong>ПРИОРИТЕТ 3 (СРЕДНИЙ/НИЗКИЙ — запланировать в бэклог):</strong><br>';
  var lowFindings = findings.filter(function(f) { return f.severity === 'medium' || f.severity === 'low'; });
  if (lowFindings.length > 0) {
    lowFindings.forEach(function(f, idx) {
      html += '  ' + (idx + 1) + '. ' + (f.type || '').replace(/_/g, ' ') + ' &#8594; ' + (f.remediation || 'требует анализа') + '<br>';
    });
  } else {
    html += '  (нет средних/низких уязвимостей)<br>';
  }
  html += '</div>';
  
  return html;
}

