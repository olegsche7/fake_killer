  } catch (e) { logToScreen('&#10060; Прокси не работает: ' + e.message, 'error'); }
}

async function testLLMConnection() {
  clearDebugLog();
  if (currentProvider === 'groq') {
    if (!groqKey || groqKey.length < 20 || !selectedModel) { logToScreen('&#10060; Проверьте ключ и модель', 'error'); return; }
    try {
      var res = await fetch(buildUrl(GROQ_API_URL_BASE), {
        method: 'POST', headers: {'Authorization': 'Bearer ' + groqKey, 'Content-Type': 'application/json'},
        body: JSON.stringify({ model: selectedModel, messages: [{role: 'user', content: 'OK'}], max_tokens: 5, temperature: 0 })
      });
      logToScreen(res.ok ? '&#9989; Groq работает!' : '&#10060; Ошибка: ' + res.status, res.ok ? 'success' : 'error');
      llmAvailable = res.ok; updateLLMBadge();
    } catch (e) { logToScreen('&#10060; Сеть: ' + e.message, 'error'); llmAvailable = false; updateLLMBadge(); }
  }
}

