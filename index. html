    logToScreen('&#9989; Анализ завершён (локально)', 'info');
  }
  document.getElementById('loading').classList.remove('active');
  document.getElementById('res').style.display = 'block';
  document.getElementById('llm-result').style.display = 'none';
  runEvaluate();
}

function autoDetectAndApplyDomain(query) {
  var detected = detectDomain(query);
  if (detected && DOMAINS[detected]) {
    currentDomain = detected;
    applyDomainWeights();
    if (currentMode !== 'system') updateWeightsInfo();
    logToScreen('&#127760; Сфера: ' + DOMAINS[detected].name, 'info');
  }
}

function runEvaluate() {
  var dom = DOMAINS[currentDomain];
  var weights = [...dom.weights];
  if(llmResult && llmResult.dynamic_weights) {
    var weightMap = {'гомеостаз': 0, 'симбиоз': 1, 'энергоэф.': 2, 'антихрупкость': 3, 'простота': 4, 'поток инфо': 5, 'эвоц.потенц': 6, 'кооперация': 7, 'мин.страд.': 8, 'будущ.возм.': 9};
    for(var key in llmResult.dynamic_weights) {
      var idx = weightMap[key.toLowerCase()];
      if(idx !== undefined) weights[idx] = llmResult.dynamic_weights[key];
    }
  }
  var sc = calculateNonlinearScore(vals, weights);
  var totalPenalty = hallucinationPenalty + contradictionPenalty + fluffPenalty + llmPenalty + wikiPenalty + memoryPenalty + metaPenalty;
  if(totalPenalty > 0) { sc = sc * (1 - totalPenalty); sc = Math.max(0.1, sc); }
  var hasProtocolMarkers = hallucinations.some(function(h) { return h.category === 'fake_protocols'; });
  if(hasProtocolMarkers) sc = Math.min(sc, 0.25);
  else if(hallucinations.length >= 8) sc = 0.10;
  else if(hallucinations.length >= 5) sc = Math.min(sc, 0.20);
  else if(hallucinations.length >= 3) sc = Math.min(sc, 0.30);
  if(debateResult && debateResult.judge) {
    if (currentMode === 'resume') {
      if(debateResult.judge.verdict === 'hire') sc = Math.min(sc + 0.15, 1.0);
      else if(debateResult.judge.verdict === 'reject') sc = Math.max(sc - 0.10, 0.1);
    } else {
      if(debateResult.judge.verdict === 'real') sc = Math.min(sc + 0.10, 1.0);
      else if(debateResult.judge.verdict === 'fake') sc = Math.max(sc - 0.05, 0.1);
    }
  }
  var bestScore = -1, best = null, bestMetrics = null;
  for(var j = 0; j < dom.archetypes.length; j++) {
    var metrics = combinedScore(vals, dom.archetypes[j].pattern, weights);
    if(metrics.combined > bestScore) { bestScore = metrics.combined; best = dom.archetypes[j]; bestMetrics = metrics; }
  }
  if(hasProtocolMarkers || hallucinations.length >= 3) {
    if(currentDomain === 'science') {
      var m = dom.archetypes.find(function(a) { return a.name.indexOf('Мошенник') !== -1; });
      if(m) { best = m; bestMetrics = combinedScore(vals, best.pattern, weights); }
    } else if(currentDomain === 'business') {
      var m = dom.archetypes.find(function(a) { return a.name.indexOf('Гуру') !== -1; });
      if(m) { best = m; bestMetrics = combinedScore(vals, best.pattern, weights); }
    }
  }
  lastConfidence = { cosine: bestMetrics.cosine, euclidean: bestMetrics.euclidean, combined: bestMetrics.combined, archetype: best.name };
  document.getElementById('sc').textContent = sc.toFixed(2);
  document.getElementById('arch-name').textContent = best.name;
  document.getElementById('arch-desc').textContent = best.desc;
  document.getElementById('confidence').textContent = 'Уверенность: ' + (bestMetrics.combined * 100).toFixed(1) + '%';
  document.getElementById('res').style.display = 'block';
  document.getElementById('sc').classList.toggle('good', sc >= 0.7 && hallucinations.length === 0);
  document.getElementById('sc').classList.toggle('penalty', sc < 0.3 && hallucinations.length >= 3);
  document.getElementById('metric-confidence').textContent = 'Уверенность: ' + (bestMetrics.combined * 100).toFixed(1) + '%';
  document.getElementById('metric-debate').textContent = 'LLM: ' + (debateResult && debateResult.judge ? (debateResult.judge.final_confidence * 100).toFixed(0) + '%' : 'N/A');
  document.getElementById('metric-textlen').textContent = 'Длина: ' + document.getElementById('query').value.length + ' симв.';
  document.getElementById('metric-unique').textContent = 'Маркеры: ' + uniqueMarkers;
