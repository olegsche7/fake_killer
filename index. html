function buildUrl(baseUrl) {
  if (!corsProxy) return baseUrl;
  if (corsProxy.indexOf('allorigins') !== -1 || corsProxy.indexOf('corsproxy.io') !== -1 || corsProxy.indexOf('?url=') !== -1 || corsProxy.indexOf('?quest=') !== -1) {
    return corsProxy + encodeURIComponent(baseUrl);
  }
  return corsProxy + baseUrl;
}

function extractJSON(text) {
  if (!text) return null;
  addDebugLog('&#128221; Парсинг JSON (длина: ' + text.length + ')', 'info');
  var cleanText = text.replace(/```json\s*/gi, '').replace(/```\s*/gi, '').trim();
  var match = cleanText.match(/\{[\s\S]*\}/);
  if (match) {
    try { return JSON.parse(match[0]); }
    catch (e) {
      addDebugLog('&#9888;&#65039; Ошибка парсинга {}, пробуем исправить...', 'warning');
      var fixed = match[0].replace(/\/\/.*$/gm, '').replace(/,\s*}/g, '}').replace(/,\s*]/g, ']').replace(/'/g, '"');
      try { return JSON.parse(fixed); } catch (e2) { }
    }
  }
  match = cleanText.match(/\[[\s\S]*\]/);
  if (match) { try { return JSON.parse(match[0]); } catch (e) { } }
  if (text.toLowerCase().includes('вопрос') || text.toLowerCase().includes('question')) {
    addDebugLog('&#9888;&#65039; JSON не найден, применяем текстовый fallback', 'warning');
    var lines = text.split('\n').filter(function(line) { return line.trim().length > 20 && (line.includes('?') || line.toLowerCase().includes('вопрос')); });
    var fallbackQuestions = [];
    for (var i = 0; i < Math.min(3, lines.length); i++) {
      fallbackQuestions.push({ question: lines[i].replace(/^[\d\.\-\*\s]+/, '').trim(), target: "Извлечено из текста (fallback)" });
    }
    if (fallbackQuestions.length > 0) {
      addDebugLog('&#9989; Успешно извлечено ' + fallbackQuestions.length + ' вопросов через fallback', 'success');
      return { questions: fallbackQuestions };
    }
  }
  addDebugLog('&#10060; JSON не найден и fallback не сработал', 'error');
  return null;
}

async function callLLM(messages, maxTokens, maxRetries, phaseName) {
  addDebugLog('=== ' + phaseName + ' ===', 'info');
  addDebugLog('Модель: ' + selectedModel + ' | Токены: ' + maxTokens, 'info');
  var lastError = null;
  for (var attempt = 1; attempt <= maxRetries; attempt++) {
    try {
      addDebugLog('Попытка ' + attempt + '/' + maxRetries + '...', 'info');
      var baseUrl = currentProvider === 'hf' ? HF_CHAT_URL_BASE : GROQ_API_URL_BASE;
      var url = buildUrl(baseUrl);
      var token = currentProvider === 'hf' ? hfKey : groqKey;
      var requestBody = {
        model: selectedModel,
        messages: messages,
        max_tokens: maxTokens,
        temperature: 0.1,
        response_format: { type: "json_object" }
      };
      var response = await fetch(url, {
        method: 'POST',
        headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
        body: JSON.stringify(requestBody)
      });
      addDebugLog('HTTP статус: ' + response.status, response.ok ? 'success' : 'error');
      var responseText = await response.text();
      if (response.status === 429) {
        var waitTime = 30000;
        var retryMatch = responseText.match(/try again in ([\d.]+)s/i);
        if (retryMatch) waitTime = Math.ceil(parseFloat(retryMatch[1]) * 1000) + 5000;
        addDebugLog('&#9203; Rate limit, ждём ' + (waitTime/1000) + ' сек...', 'warning');
        logToScreen('&#9203; Rate limit, ждём ' + Math.round(waitTime/1000) + ' сек...', 'warning');
        await new Promise(r => setTimeout(r, waitTime));
        if (attempt < maxRetries) continue;
        else { lastError = new Error('Rate limit'); break; }
      }
      if (response.status === 503) {
        await new Promise(r => setTimeout(r, 60000 * attempt));
        continue;
      }
      if (!response.ok) {
        lastError = new Error('HTTP ' + response.status + ': ' + responseText.substring(0, 500));
        if (responseText.indexOf('model_not_found') !== -1) { await loadModels(); throw new Error('Модель обновлена'); }
        if (attempt < maxRetries) { await new Promise(r => setTimeout(r, 5000)); continue; }
      }
      var data = JSON.parse(responseText);
      if (!data.choices || !data.choices[0] || !data.choices[0].message) throw new Error('Неверная структура');
      return data.choices[0].message.content;
    } catch (error) {
      addDebugLog('&#10060; Исключение: ' + error.message, 'error');
      lastError = error;
      if (attempt < maxRetries) { await new Promise(r => setTimeout(r, 5000)); }
    }
  }
  throw lastError || new Error('Все попытки не удались');
}

async function analyzeWithLLMDebate(text, jobDescription) {
  var cacheKey = currentMode + '_' + currentProvider + '_' + selectedModel + '_' + text.substring(0, 80);
