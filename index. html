// ============================================
// МАТЕМАТИКА
// ============================================
function cosineSimilarity(vecA, vecB, weights) {
  var dotProduct = 0, magnitudeA = 0, magnitudeB = 0;
  for (var i = 0; i < vecA.length; i++) {
    var w = weights[i] || 1;
    var a = vecA[i] * w, b = vecB[i] * w;
    dotProduct += a * b; magnitudeA += a * a; magnitudeB += b * b;
  }
  magnitudeA = Math.sqrt(magnitudeA); magnitudeB = Math.sqrt(magnitudeB);
  if (magnitudeA === 0 || magnitudeB === 0) return 0;
  return dotProduct / (magnitudeA * magnitudeB);
}

function normalizedEuclideanDistance(vecA, vecB, weights) {
  var sum = 0, maxPossible = 0;
  for (var i = 0; i < vecA.length; i++) {
    var w = weights[i] || 1;
    var diff = (vecA[i] - vecB[i]) * w;
    sum += diff * diff; maxPossible += w * w;
  }
  var distance = Math.sqrt(sum);
  var maxDistance = Math.sqrt(maxPossible);
  if (maxDistance === 0) return 0;
  return distance / maxDistance;
}

function combinedScore(vecA, vecB, weights) {
  var cosSim = cosineSimilarity(vecA, vecB, weights);
  var eucDist = normalizedEuclideanDistance(vecA, vecB, weights);
  return { combined: 0.6 * cosSim + 0.4 * (1 - eucDist), cosine: cosSim, euclidean: 1 - eucDist };
}

function sigmoid(x) { return 1 / (1 + Math.exp(-6 * (x - 0.5))); }

function calculateNonlinearScore(vals, weights) {
  var baseScore = 0;
  for (var i = 0; i < vals.length; i++) baseScore += vals[i] * weights[i];
  var nonlinearScore = sigmoid(baseScore);
  var criticalPairs = [[3, 0], [3, 8], [1, 7]];
  var penalty = 1.0;
  for (var p = 0; p < criticalPairs.length; p++) {
    if (vals[criticalPairs[p][0]] < 0.3 && vals[criticalPairs[p][1]] < 0.3) penalty *= 0.7;
  }
  return nonlinearScore * penalty;
}

// ============================================
// DETECT HALLUCINATIONS
// ============================================
function detectHallucinations(text) {
  var lower = text.toLowerCase();
  var found = [];
  for (var category in HALLUCINATION_MARKERS) {
    var markers = HALLUCINATION_MARKERS[category];
    for (var i = 0; i < markers.length; i++) {
      if (lower.indexOf(markers[i]) !== -1) found.push({category: category, marker: markers[i]});
    }
  }
  var numberPatterns = [/\d+00%\s*(эффективност|рост|доходност|увелич)/i, /в\s+\d+\s+раз\s+(быстр|лучш|эффектив)/i, /за\s+\d+\s+(дня|недел|месяц)/i];
  for (var i = 0; i < numberPatterns.length; i++) {
    if (numberPatterns[i].test(text)) found.push({category: 'fake_numbers', marker: 'числовой паттерн #' + (i+1)});
  }
  return found;
}

// ============================================
// DETECT CONTRADICTIONS
// ============================================
function detectContradictions(text) {
  var lower = text.toLowerCase();
  var allPos = [], allNeg = [];
  for (var p = 0; p < CONTRADICTION_PAIRS.length; p++) {
    var pair = CONTRADICTION_PAIRS[p];
    for (var i = 0; i < pair.pos.length; i++) { if (lower.indexOf(pair.pos[i]) !== -1) allPos.push(pair.pos[i]); }
    for (var i = 0; i < pair.neg.length; i++) { if (lower.indexOf(pair.neg[i]) !== -1) allNeg.push(pair.neg[i]); }
  }
  if (allPos.length > 0 && allNeg.length > 0) {
    return { found: true, posMarkers: allPos, negMarkers: allNeg, message: 'Позитивная самооценка (' + allPos.slice(0, 3).join(', ') + ') противоречит негативным фактам (' + allNeg.slice(0, 3).join(', ') + '). Это признак самообмана или когнитивного искажения.' };
  }
  return { found: false };
}

// ============================================
// DETECT FLUFF
// ============================================
function detectFluff(text) {
  var lower = text.toLowerCase();
  var found = [];
  for (var i = 0; i < FLUFF_MARKERS.length; i++) { if (lower.indexOf(FLUFF_MARKERS[i]) !== -1) found.push(FLUFF_MARKERS[i]); }
  return found;
}

// ============================================
// DETECT DOMAIN
// ============================================
function detectDomain(text) {
  var lower = text.toLowerCase();
  var scienceBoosters = ["аспирант", "диссертаци", "дипломн", "научный руководитель", "квантов", "физик", "КПД", "импакт", "хирш", "рецензи", "цитиру", "публикац", "стать", "метод", "гипотез", "эксперимент", "анализ", "исследован", "лаборатор", "университет", "конференц", "профессор", "кафедр", "институт", "академи", "теломер", "эпигенетич", "сайленсинг", "омоложен", "клиник", "пациент", "биологич", "генетич", "молекулярн", "клеточн", "нейрон", "синапс", "фермент", "белок", "ДНК", "РНК", "CRISPR", "ген", "дудн", "шарпантье", "cell", "nature", "science"];
  var scienceScore = 0;
  for (var i = 0; i < scienceBoosters.length; i++) { if (lower.indexOf(scienceBoosters[i]) !== -1) scienceScore += 2; }
  
  var best = 'health', maxScore = 0;
  for (var d = 0; d < Object.keys(DOMAINS).length; d++) {
    var domKey = Object.keys(DOMAINS)[d];
    var dom = DOMAINS[domKey];
    var score = 0, uniqueScore = 0;
    for (var i = 0; i < dom.keywords.length; i++) {
      var kw = dom.keywords[i];
      for (var j = 0; j < kw.pos.length; j++) { if (lower.indexOf(kw.pos[j]) !== -1) { score += 1; if (kw.pos[j].length > 8) uniqueScore += 0.5; } }
      for (var j = 0; j < kw.neg.length; j++) { if (lower.indexOf(kw.neg[j]) !== -1) { score += 1; if (kw.neg[j].length > 8) uniqueScore += 0.5; } }
    }
    if (domKey === 'science') score += scienceScore;
    var finalScore = score + uniqueScore;
    if (finalScore > maxScore) { maxScore = finalScore; best = domKey; }
  }
  return best;
}

