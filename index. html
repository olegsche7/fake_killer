async function analyzeWithLLM(text, retryCount = 0) {
  if (!GROQ_API_KEY || GROQ_API_KEY.length < 20) {
    logToScreen('❌ КЛЮЧ НЕВАЛИДЕН! Длина: ' + (GROQ_API_KEY ? GROQ_API_KEY.length : 0), 'error');
    return null;
  }
  
  if (retryCount >= 2) {
    logToScreen('❌ Превышено количество попыток (2). LLM недоступен.', 'error');
    return null;
  }
  
  requestCount++;
  var startTime = Date.now();
  logToScreen(`🔄 Запрос #${requestCount} к Groq API (попытка ${retryCount + 1}/3)...`, 'info');
  
  var prompt = `Ты — универсальный анализатор паттернов стабильности систем. Проанализируй текст и верни СТРОГО JSON без пояснений, markdown и комментариев вне JSON.
Формат ответа:
{
  "domain": "наука/бизнес/здоровье/код/отношения/финансы/другое",
  "structural_facts": {"has_reserves": true/false, "has_single_point_of_failure": true/false, "has_feedback_loops": true/false},
  "contradictions": ["список логических противоречий"],
  "suspicious_claims": ["список подозрительных утверждений"],
  "manipulative_language": ["манипулятивные фразы"],
  "overall_stability": 0.5,
  "archetype_hint": "подсказка об архетипе",
  "confidence": 0.8
}
Текст для анализа: "${text}"`;

  try {
    var response = await fetch(GROQ_API_URL, {
      method: 'POST',
      headers: {
        'Authorization': 'Bearer ' + GROQ_API_KEY,
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        model: GROQ_MODEL,
        messages: [{role: 'user', content: prompt}],
        temperature: 0.3,
        max_tokens: 800
      })
    });
    
    var responseTime = Date.now() - startTime;
    logToScreen(`📡 HTTP ${response.status} ${response.statusText} (${responseTime}мс)`, 'info');
    
    if (!response.ok) {
      var errorText = await response.text();
      logToScreen(`❌ Ошибка Groq API: ${errorText.substring(0, 200)}`, 'error');
      
      // Retry при 429 (rate limit) или 5xx
      if ((response.status === 429 || response.status >= 500) && retryCount < 2) {
        logToScreen(`⚠️ Повторная попытка через 2 сек...`, 'warning');
        await new Promise(resolve => setTimeout(resolve, 2000));
        return await analyzeWithLLM(text, retryCount + 1);
      }
      
      llmAvailable = false;
      updateLLMBadge();
      return null;
    }
    
    var data = await response.json();
    var llmResponse = data.choices[0].message.content;
    var responseSize = JSON.stringify(data).length;
    logToScreen(`✅ Ответ получен за ${responseTime}мс (размер: ${responseSize} байт)`, 'success');
    
    var jsonMatch = llmResponse.match(/\{[\s\S]*\}/);
    if (jsonMatch) {
      return JSON.parse(jsonMatch[0]);
    }
    logToScreen('⚠️ JSON не найден в ответе', 'warning');
    return null;
  } catch (error) {
    logToScreen(`❌ Ошибка сети: ${error.name} - ${error.message}`, 'error');
    llmAvailable = false;
    updateLLMBadge();
    return null;
  }
}

