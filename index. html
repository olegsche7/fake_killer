function exportPatternsDB() {
  var db = { userPatterns: userPatterns, abstractPatterns: abstractPatterns, exportDate: new Date().toISOString() };
  var dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(db, null, 2));
  var a = document.createElement('a'); a.setAttribute("href", dataStr); a.setAttribute("download", "database_" + Date.now() + ".json");
  document.body.appendChild(a); a.click(); a.remove();
  logToScreen('&#128229; База экспортирована', 'success');
}

function importPatternsDB(input) {
  var file = input.files[0]; if (!file) return;
  var reader = new FileReader();
  reader.onload = function(e) {
    try {
      var db = JSON.parse(e.target.result);
      if (db.userPatterns) userPatterns = [...new Set([...userPatterns, ...db.userPatterns])];
      if (db.abstractPatterns) {
        db.abstractPatterns.forEach(function(newP) {
          if (!abstractPatterns.find(function(p) { return p.rule === newP.rule; })) abstractPatterns.push(newP);
        });
      }
      localStorage.setItem('pattern_ai_user_patterns', JSON.stringify(userPatterns));
      localStorage.setItem('pattern_ai_abstract_patterns', JSON.stringify(abstractPatterns));
      updateMemoryDisplay();
      logToScreen('&#9989; База импортирована! (Всего: ' + (userPatterns.length + abstractPatterns.length) + ')', 'success');
    } catch (err) { logToScreen('&#10060; Ошибка чтения файла', 'error'); }
  };
  reader.readAsText(file);
}

