function detectHallucinations(text) {
  var lower = text.toLowerCase();
  var found = [];
  for (var category in HALLUCINATION_MARKERS) {
    var markers = HALLUCINATION_MARKERS[category];
    for (var i = 0; i < markers.length; i++) {
      if (lower.indexOf(markers[i]) !== -1) found.push({category: category, marker: markers[i]});
    }
  }
  return found;
}

function detectContradictions(text) {
  var lower = text.toLowerCase();
  var allPos = [], allNeg = [];
  for (var p = 0; p < CONTRADICTION_PAIRS.length; p++) {
    var pair = CONTRADICTION_PAIRS[p];
    for (var i = 0; i < pair.pos.length; i++) { if (lower.indexOf(pair.pos[i]) !== -1) allPos.push(pair.pos[i]); }
    for (var i = 0; i < pair.neg.length; i++) { if (lower.indexOf(pair.neg[i]) !== -1) allNeg.push(pair.neg[i]); }
  }
  if (allPos.length > 0 && allNeg.length > 0) {
    return { found: true, posMarkers: allPos, negMarkers: allNeg, message: 'Позитивная самооценка (' + allPos.slice(0, 3).join(', ') + ') противоречит негативным фактам (' + allNeg.slice(0, 3).join(', ') + ').' };
  }
  return { found: false };
}

function detectFluff(text) {
  var lower = text.toLowerCase();
  var found = [];
  for (var i = 0; i < FLUFF_MARKERS.length; i++) { if (lower.indexOf(FLUFF_MARKERS[i]) !== -1) found.push(FLUFF_MARKERS[i]); }
  return found;
}

function detectDomain(text) {
  var lower = text.toLowerCase();
  var scienceBoosters = ["аспирант", "диссертаци", "дипломн", "научный руководитель", "квантов", "физик", "КПД", "импакт", "хирш", "рецензи", "цитиру", "публикац", "стать", "метод", "гипотез", "эксперимент", "анализ", "исследован", "лаборатор", "университет", "конференц", "профессор", "кафедр", "институт", "академи", "теломер", "эпигенетич", "сайленсинг", "омоложен", "клиник", "пациент", "биологич", "генетич", "молекулярн", "клеточн", "нейрон", "синапс", "фермент", "белок", "ДНК", "РНК", "CRISPR", "ген", "дудн", "шарпантье", "cell", "nature", "science"];
  var scienceScore = 0;
  for (var i = 0; i < scienceBoosters.length; i++) { if (lower.indexOf(scienceBoosters[i]) !== -1) scienceScore += 2; }
  var best = 'health', maxScore = 0;
  for (var d = 0; d < Object.keys(DOMAINS).length; d++) {
    var domKey = Object.keys(DOMAINS)[d];
    var dom = DOMAINS[domKey];
    var score = 0, uniqueScore = 0;
    for (var i = 0; i < dom.keywords.length; i++) {
      var kw = dom.keywords[i];
      for (var j = 0; j < kw.pos.length; j++) { if (lower.indexOf(kw.pos[j]) !== -1) { score += 1; if (kw.pos[j].length > 8) uniqueScore += 0.5; } }
      for (var j = 0; j < kw.neg.length; j++) { if (lower.indexOf(kw.neg[j]) !== -1) { score += 1; if (kw.neg[j].length > 8) uniqueScore += 0.5; } }
    }
    if (domKey === 'science') score += scienceScore;
    var finalScore = score + uniqueScore;
    if (finalScore > maxScore) { maxScore = finalScore; best = domKey; }
  }
  return best;
}

