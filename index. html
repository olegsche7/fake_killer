async function analyzeText() {
  var query = document.getElementById('query').value.toLowerCase();
  if(!query) { logToScreen('&#9888;&#65039; Введите текст', 'warning'); return; }
  var jobDescription = document.getElementById('job-description').value.trim();
  pendingPatterns = [];
  document.getElementById('loading').classList.add('active');
  document.getElementById('loading-status').textContent = 'Локальный анализ...';
  
  cloudLog('&#128260; Синхронизация с облаком...', 'info');
  try {
    var cloudUrl = CLOUD_API + '/patterns';
    if (corsProxy) cloudUrl = buildUrl(CLOUD_API + '/patterns');
    var cloudResponse = await fetch(cloudUrl, { method: 'GET', headers: { 'Accept': 'application/json' } });
    if (cloudResponse.ok) {
      var cloudData = await cloudResponse.json();
      var newCount = 0;
      cloudData.patterns.forEach(p => {
        if (!abstractPatterns.find(ap => ap.rule === p.rule)) {
          abstractPatterns.push(p);
          newCount++;
        }
      });
      if (newCount > 0) {
        localStorage.setItem('pattern_ai_abstract_patterns', JSON.stringify(abstractPatterns));
        updateMemoryDisplay();
        cloudLog('&#9989; Загружено ' + newCount + ' новых паттернов из облака', 'success');
      } else {
        cloudLog('&#9888;&#65039; Облако синхронизировано (новых нет)', 'info');
      }
    } else {
      cloudLog('&#9888;&#65039; Облако вернуло: ' + cloudResponse.status, 'warning');
    }
  } catch (e) {
    cloudLog('&#9888;&#65039; Облако недоступно, работаю локально: ' + e.message, 'warning');
  }
  
  var concreteness = analyzeConcreteness(document.getElementById('query').value);
  hallucinations = detectHallucinations(query);
  hallucinationPenalty = Math.min(0.75, hallucinations.length * 0.15);
  document.getElementById('warning-box').style.display = hallucinations.length > 0 ? 'block' : 'none';
  if(hallucinations.length > 0) {
    document.getElementById('warning-count').textContent = 'Обнаружено ' + hallucinations.length + ' маркеров:';
    document.getElementById('warning-list').innerHTML = hallucinations.map(function(h) { return '<li><strong>' + h.marker + '</strong> (' + h.category + ')</li>'; }).join('');
  }
  contradictions = detectContradictions(query);
  contradictionPenalty = contradictions.found ? 0.10 : 0;
  document.getElementById('contradiction-box').style.display = contradictions.found ? 'block' : 'none';
  if(contradictions.found) document.getElementById('contradiction-text').textContent = contradictions.message;
  fluffMarkers = detectFluff(query);
  if(fluffMarkers.length > 0) {
    document.getElementById('fluff-box').style.display = 'block';
    document.getElementById('fluff-text').textContent = 'Найдено ' + fluffMarkers.length + ' маркеров: ' + fluffMarkers.slice(0, 5).join(', ');
  } else { document.getElementById('fluff-box').style.display = 'none'; }
  var userPatternMatches = detectUserPatterns(query);
  memoryPenalty = Math.min(0.50, userPatternMatches.length * 0.15);
  if(userPatternMatches.length > 0) { hallucinations = hallucinations.concat(userPatternMatches); hallucinationPenalty = Math.min(0.75, hallucinations.length * 0.15); }
  autoDetectAndApplyDomain(query);
  var dom = DOMAINS[currentDomain];
  uniqueMarkers = 0;
  for(var i = 0; i < 10; i++) {
    var posCount = 0, negCount = 0, kw = dom.keywords[i];
    kw.pos.forEach(function(w) { if(query.indexOf(w) !== -1) { posCount++; uniqueMarkers++; } });
    kw.neg.forEach(function(w) { if(query.indexOf(w) !== -1) { negCount++; uniqueMarkers++; } });
    vals[i] = Math.max(0.1, Math.min(0.95, 0.5 + (posCount * 0.15) - (negCount * 0.25)));
    originalVals[i] = vals[i];
    var slider = document.getElementById('slider' + i); if (slider) slider.value = vals[i];
    var valEl = document.getElementById('v' + i); if (valEl) valEl.textContent = vals[i].toFixed(2);
  }
  document.getElementById('loading-status').textContent = 'Мета-анализ...';
  metaPatterns = detectMetaPatterns(vals);
  metaPenalty = metaPatterns.filter(function(p) { return p.severity === 'critical'; }).length * 0.15 + metaPatterns.filter(function(p) { return p.severity === 'warning'; }).length * 0.08;
  document.getElementById('meta-patterns-box').style.display = metaPatterns.length > 0 ? 'block' : 'none';
  if(metaPatterns.length > 0) document.getElementById('meta-patterns-list').innerHTML = displayMetaPatterns(metaPatterns);
  document.getElementById('loading-status').textContent = 'Wikipedia...';
  var entities = extractEntities(document.getElementById('query').value);
  wikiResult = null; wikiPenalty = 0;
  document.getElementById('wiki-box').style.display = 'none';
  // === Википедия только для режима "Фейки" ===
  if(entities.length > 0 && currentMode === 'factcheck') {
    try {
      wikiResult = await Promise.all(entities.map(async function(entity) {
        try {
          var res = await fetch(WIKIPEDIA_API_URL + encodeURIComponent(entity));
          if(res.ok) { var d = await res.json(); return {name: entity, found: true, summary: d.extract ? d.extract.substring(0, 100) : 'Найдена'}; }
          return {name: entity, found: false};
        } catch(e) { return {name: entity, found: false}; }
      }));
      var wikiHtml = wikiResult.map(function(w) { return (w.found ? '&#9989; ' : '&#10060; ') + w.name + (w.found ? ': ' + w.summary : ': нет') + '<br>'; }).join('');
      document.getElementById('wiki-box').style.display = 'block';
      document.getElementById('wiki-results').innerHTML = wikiHtml;
      wikiPenalty = Math.min(0.50, wikiResult.filter(function(w) { return !w.found; }).length * 0.15);
    } catch(e) { logToScreen('&#9888;&#65039; Wikipedia недоступен', 'warning'); }
  }
  document.getElementById('loading-status').textContent = 'LLM дебаты...';
  llmResult = null; debateResult = null; llmPenalty = 0; interviewQuestions = [];
  document.getElementById('llm-analysis-box').style.display = 'none';
  document.getElementById('debate-box').style.display = 'none';
  document.getElementById('questions-box').style.display = 'none';
  document.getElementById('security-box').style.display = 'none';
  document.getElementById('concreteness-box').style.display = 'block';
  document.getElementById('concreteness-content').innerHTML = displayConcreteness(concreteness);
  try { 
    llmResult = await analyzeWithLLMDebate(document.getElementById('query').value, jobDescription);
    debateResult = llmResult ? llmResult.debate : null;
  } catch (e) { logToScreen('&#10060; Ошибка LLM: ' + e.message, 'error'); }
  if(llmResult) {
