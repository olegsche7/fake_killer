  document.getElementById('examples-fake').classList.toggle('hidden', mode !== 'factcheck');
  document.getElementById('examples-resume').classList.toggle('hidden', mode !== 'resume');
  document.getElementById('resume-fields').classList.toggle('hidden', mode !== 'resume');
