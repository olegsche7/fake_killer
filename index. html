      try {
        var qRes = extractJSON(await callLLM([{role: 'system', content: 'Ты опытный аналитик/рекрутер. Возвращай ТОЛЬКО JSON.'}, {role: 'user', content: questionsPrompt}], 400, 2, 'ГЕНЕРАТОР ВОПРОСОВ'));
