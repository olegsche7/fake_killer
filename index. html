function runEvaluate() {
  var dom = DOMAINS[currentDomain];
  var sc = calculateNonlinearScore(vals, dom.weights);
  var totalPenalty = hallucinationPenalty + contradictionPenalty + fluffPenalty + llmPenalty;
  if (totalPenalty > 0) { sc = sc * (1 - totalPenalty); sc = Math.max(0.1, sc); }
  
  var bestScore = -1, best = null, bestMetrics = null;
  for (var j = 0; j < dom.archetypes.length; j++) {
    var metrics = combinedScore(vals, dom.archetypes[j].pattern, dom.weights);
    if (metrics.combined > bestScore) { bestScore = metrics.combined; best = dom.archetypes[j]; bestMetrics = metrics; }
  }
  
  if (llmResult && llmResult.archetype_hint) {
    var hint = llmResult.archetype_hint.toLowerCase();
    if (hint.includes('мошенник') || hint.includes('fraud')) {
      for (var j = 0; j < dom.archetypes.length; j++) {
        if (dom.archetypes[j].name.includes('Мошенник')) { best = dom.archetypes[j]; bestMetrics = combinedScore(vals, best.pattern, dom.weights); break; }
      }
    } else if (hint.includes('гуру') || hint.includes('guru')) {
      for (var j = 0; j < dom.archetypes.length; j++) {
        if (dom.archetypes[j].name.includes('Гуру')) { best = dom.archetypes[j]; bestMetrics = combinedScore(vals, best.pattern, dom.weights); break; }
      }
    }
  }
  
  if (hallucinations.length >= 2 && sc < 0.4) {
    if (currentDomain === 'science') {
      for (var j = 0; j < dom.archetypes.length; j++) {
        if (dom.archetypes[j].name === "Академический Мошенник") { best = dom.archetypes[j]; bestMetrics = combinedScore(vals, best.pattern, dom.weights); break; }
      }
    } else if (currentDomain === 'business') {
      for (var j = 0; j < dom.archetypes.length; j++) {
        if (dom.archetypes[j].name === "🎭 Фейковый Гуру") { best = dom.archetypes[j]; bestMetrics = combinedScore(vals, best.pattern, dom.weights); break; }
      }
    }
  }
  
  lastConfidence = { cosine: bestMetrics.cosine, euclidean: bestMetrics.euclidean, combined: bestMetrics.combined, archetype: best.name };
  document.getElementById('sc').textContent = sc.toFixed(2);
  document.getElementById('arch-name').textContent = best.name;
  document.getElementById('arch-desc').textContent = best.desc;
  var confText = 'Уверенность: ' + (bestMetrics.combined * 100).toFixed(1) + '% (косинус: ' + (bestMetrics.cosine * 100).toFixed(0) + '%, евклидово: ' + (bestMetrics.euclidean * 100).toFixed(0) + '%)';
  document.getElementById('confidence').textContent = confText;
  document.getElementById('res').style.display = 'block';
  document.getElementById('llm-result').style.display = 'none';
  
  if (sc >= 0.7 && hallucinations.length === 0) document.getElementById('sc').classList.add('good');
  else document.getElementById('sc').classList.remove('good');
  
  document.getElementById('metric-confidence').textContent = 'Уверенность: ' + (bestMetrics.combined * 100).toFixed(1) + '%';
  document.getElementById('metric-textlen').textContent = 'Длина текста: ' + textLength + ' символов';
  document.getElementById('metric-unique').textContent = 'Уникальных маркеров: ' + uniqueMarkers;
  document.getElementById('metric-llm').textContent = 'LLM-анализ: ' + (llmResult ? '✅ выполнен' : '⚠️ недоступен');
  
  if (totalPenalty > 0) {
    var penaltyText = '️ Штрафы: ';
    var parts = [];
    if (hallucinationPenalty > 0) parts.push('-' + (hallucinationPenalty * 100).toFixed(0) + '% за выдумки');
    if (contradictionPenalty > 0) parts.push('-10% за противоречия');
    if (fluffPenalty > 0) parts.push('-' + (fluffPenalty * 100).toFixed(0) + '% за "воду"');
    if (llmPenalty > 0) parts.push('-' + (llmPenalty * 100).toFixed(0) + '% от LLM');
    document.getElementById('penalty-badge').textContent = penaltyText + parts.join(', ');
    document.getElementById('penalty-badge').style.display = 'block';
    document.getElementById('sc').classList.add('penalty');
  } else {
    document.getElementById('penalty-badge').style.display = 'none';
    document.getElementById('sc').classList.remove('penalty');
  }
  
  document.getElementById('res').scrollIntoView({behavior: 'smooth'});
}

function getLocalAnalysis() {
  var dom = DOMAINS[currentDomain];
  var sc = parseFloat(document.getElementById('sc').textContent);
  var archName = document.getElementById('arch-name').textContent;
  var archDesc = document.getElementById('arch-desc').textContent;
  var sorted = [];
  for (var i = 0; i < CRITERIA.length; i++) { sorted.push({name: CRITERIA[i].n, val: vals[i], w: dom.weights[i], desc: dom.descriptions[i]}); }
  sorted.sort(function(a, b) { return a.val - b.val; });
  var weakest = sorted[0];
  var text = '📊 СОСТОЯНИЕ СИСТЕМЫ (v9.2)\n━━━━━━━━━━━━━━━━━━━━━\n';
  text += 'Сфера: ' + dom.name + '\nОбщий балл: ' + sc.toFixed(2) + ' из 1.00\n';
  text += 'Длина текста: ' + textLength + ' символов\n';
  text += 'Уникальных маркеров: ' + uniqueMarkers + '\n';
  text += 'LLM-анализ: ' + (llmResult ? '✅ выполнен' : '️ недоступен') + '\n\n';
  text += 'Архетип: ' + archName + ' (Уверенность: ' + (lastConfidence.combined * 100).toFixed(1) + '%)\n' + archDesc + '\n\n';
  text += '️ ГЛАВНЫЕ УЯЗВИМОСТИ\n━━━━━━━━━━━━━━━━━━━━━\n';
  if (sc < 0.4 || weakest.val < 0.5) {
    text += '1. ' + weakest.name + ' (оценка: ' + weakest.val.toFixed(2) + ')\n';
    text += '   Описание: ' + weakest.desc + '\n   Вес: ' + weakest.w + '\n\n';
  } else { text += '✅ Критических уязвимостей нет.\n\n'; }
  text += '💡 КОНКРЕТНЫЕ ШАГИ\n━━━━━━━━━━━━━━━━━━━━━\n';
  text += '📌 По архетипу (' + archName + '):\n' + (dom.archRecs[archName] || dom.archRecs['Переходное состояние']) + '\n\n';
  if (hallucinations.length > 0) text += '🚫 Найдено ' + hallucinations.length + ' галлюцинаций.\n';
  if (contradictions.found) text += '🔀 Обнаружены противоречия.\n';
  if (llmResult && llmResult.suspicious_claims && llmResult.suspicious_claims.length > 0) {
    text += '🧠 LLM нашёл подозрительные утверждения:\n';
    llmResult.suspicious_claims.forEach(function(c) { text += '   - ' + c + '\n'; });
  }
  return text;
}

function getAnalysis() {
  var btn = event.target;
  btn.disabled = true;
  setTimeout(function() {
    document.getElementById('llm-text').textContent = getLocalAnalysis();
    document.getElementById('llm-result').style.display = 'block';
    btn.disabled = false;
    document.getElementById('llm-result').scrollIntoView({behavior: 'smooth'});
  }, 400);
}

