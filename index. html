    }
    if (llmResult.security_findings && Array.isArray(llmResult.security_findings) && llmResult.security_findings.length > 0) {
      document.getElementById('security-box').style.display = 'block';
      document.getElementById('security-content').innerHTML = displaySecurityFindings(llmResult.security_findings);
      addDebugLog('&#9989; Найдено ' + llmResult.security_findings.length + ' security findings', 'success');
    }
    if(llmResult.style_analysis) {
      var llmStyle = llmResult.style_analysis;
      var llmConcreteness = {
        fluffCount: llmStyle.fluff_count || 0,
        concreteCount: llmStyle.concrete_count || 0,
        foundFluff: llmStyle.detected_fluff || [],
        foundConcrete: llmStyle.detected_facts || [],
        styleVerdict: llmStyle.verdict || 'Сбалансированный стиль',
        styleIcon: llmStyle.verdict === 'Высокая абстракция' ? '&#9888;&#65039;' : (llmStyle.verdict === 'Высокая конкретика' ? '&#9989;' : (llmStyle.verdict === 'Критический уровень клише' ? '&#128683;' : '&#9878;&#65039;')),
        styleDesc: llmStyle.verdict === 'Высокая абстракция' ? 'Текст содержит много клише, но мало доказательной базы.' : (llmStyle.verdict === 'Высокая конкретика' ? 'Текст насыщен фактами, цифрами и конкретикой.' : 'Соотношение абстракций и фактов в пределах нормы.')
      };
      document.getElementById('concreteness-content').innerHTML = displayConcreteness(llmConcreteness);
      addDebugLog('&#9989; Использован LLM-анализ стиля', 'success');
      if (llmConcreteness.fluffCount >= 4 && llmConcreteness.concreteCount <= 2) fluffPenalty = 0.25;
    }
    var llmC = llmResult.contradictions || [], llmS = llmResult.suspicious_claims || [], llmM = llmResult.manipulative_language || [];
    llmPenalty = Math.min(0.30, (llmC.length * 0.05) + (llmS.length * 0.05) + (llmM.length * 0.03));
    if(llmC.length > 0 && !contradictions.found) {
      contradictions = { found: true, message: 'LLM: ' + llmC.join('; ') };
      contradictionPenalty = 0.10;
      document.getElementById('contradiction-box').style.display = 'block';
      document.getElementById('contradiction-text').textContent = contradictions.message;
    }
    if(llmResult.meta_patterns && llmResult.meta_patterns.length > 0) {
      document.getElementById('meta-patterns-box').style.display = 'block';
      var llmMetaHtml = '<div style="margin-top:10px;padding-top:10px;border-top:1px solid rgba(255,87,34,0.3);">';
      var seen = {};
      llmResult.meta_patterns.forEach(function(mp) {
        if(seen[mp]) return; seen[mp] = true;
        llmMetaHtml += '<div class="meta-pattern-item meta-severity-warning"><div class="meta-pattern-desc">&#129504; ' + mp + '</div></div>';
      });
      llmMetaHtml += '</div>';
      document.getElementById('meta-patterns-list').innerHTML += llmMetaHtml;
    }
    logToScreen('&#9989; Анализ завершён', 'success');
