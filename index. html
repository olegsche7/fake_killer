    document.getElementById('llm-contradictions').textContent = (llmResult.contradictions || []).join('; ') || 'не обнаружены';
    document.getElementById('llm-suspicious').textContent = (llmResult.suspicious_claims || []).join('; ') || 'не обнаружены';
    var abstractPats = llmResult.abstract_patterns || [];
    document.getElementById('llm-abstract-patterns').innerHTML = abstractPats.length > 0 ? displayAbstractPatterns(abstractPats) : 'не обнаружены';
    if(abstractPats.length > 0) {
      abstractPats.forEach(function(p) { saveAbstractPattern(p); });
      logToScreen('&#128190; Сохранено ' + abstractPats.length + ' паттернов', 'success');
    }
    if(debateResult) {
      document.getElementById('debate-box').style.display = 'block';
      document.getElementById('debate-content').innerHTML = displayDebate(debateResult);
      var debateConf = debateResult.judge ? debateResult.judge.final_confidence : 0.5;
      document.getElementById('debate-confidence').textContent = (debateConf * 100).toFixed(0) + '%';
      document.getElementById('debate-confidence-bar').style.width = (debateConf * 100) + '%';
