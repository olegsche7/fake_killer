function analyzeConcreteness(text) {
  var lowerText = text.toLowerCase();
  var fluffCount = 0, concreteCount = 0;
  var foundFluff = [], foundConcrete = [];
  AI_FLUFF_PHRASES.forEach(function(phrase) {
    if (lowerText.includes(phrase.toLowerCase())) {
      fluffCount++;
      foundFluff.push(phrase);
    }
  });
  if (text.match(/\d+\s*%|\d+\s*(лет|месяцев|часов|млн|тыс|RPS|ms)/gi)) { concreteCount += 2; foundConcrete.push("Числовые метрики"); }
  if (text.match(/\b(Python|Java|JavaScript|React|AWS|Docker|Kubernetes|SQL|PostgreSQL|Go|Rust|Swift|Node\.js|C\+\+|FastAPI|Redis|JWT|SIEM|API|SSL|TLS|OAuth)\b/i)) { concreteCount += 2; foundConcrete.push("Конкретные технологии/инструменты"); }
  if (text.match(/увеличил на|сократил на|внедрил|разработал|создал|оптимизировал|deliver|reduce|increase/gi)) { concreteCount += 1; foundConcrete.push("Конкретные действия с результатом"); }
  if (text.match(/[А-Я][а-я]+\s+[А-Я][а-я]+/g)) { concreteCount += 1; foundConcrete.push("Имена собственные/названия"); }
  var styleVerdict = "Сбалансированный стиль", styleIcon = "&#9878;&#65039;", styleDesc = "Соотношение абстракций и фактов в пределах нормы.";
  if (fluffCount >= 4 && concreteCount <= 2) {
    styleVerdict = "Высокая абстракция (ИИ-шаблон или вода)"; styleIcon = "&#9888;&#65039;";
    styleDesc = "Текст содержит много клише, но мало доказательной базы. Характерно для ИИ-генерации или намеренного размывания смысла.";
  } else if (concreteCount >= 4 && fluffCount <= 2) {
    styleVerdict = "Высокая конкретика (Доказательный стиль)"; styleIcon = "&#9989;";
    styleDesc = "Текст насыщен фактами, цифрами и конкретикой. Минимум воды.";
  } else if (fluffCount >= 6) {
    styleVerdict = "Критический уровень клише"; styleIcon = "&#128683;";
    styleDesc = "Текст состоит почти исключительно из шаблонных фраз. Доверие к содержанию крайне низкое.";
  }
  return { fluffCount, concreteCount, foundFluff: foundFluff.slice(0, 5), foundConcrete, styleVerdict, styleIcon, styleDesc };
}

function populateModelSelect() {
  var select = document.getElementById('model-select');
  select.innerHTML = '';
  var models = availableModels[currentProvider] || [];
  if (models.length === 0) {
    var opt = document.createElement('option');
    opt.value = ''; opt.textContent = '— Введи ключ и обнови —';
    select.appendChild(opt); return;
  }
  for (var i = 0; i < models.length; i++) {
    var opt = document.createElement('option');
    opt.value = models[i].id; opt.textContent = models[i].name;
    select.appendChild(opt);
  }
  var found = false;
  for (var i = 0; i < models.length; i++) { if (models[i].id === selectedModel) { found = true; break; } }
  if (!found && models.length > 0) selectedModel = models[0].id;
  select.value = selectedModel;
}

async function loadModels() {
  addDebugLog('&#128260; Загрузка списка моделей...', 'info');
  logToScreen('&#128260; Загружаю модели...', 'info');
  var statusEl = currentProvider === 'groq' ? document.getElementById('groq-status') : document.getElementById('hf-status');
  if (statusEl) { statusEl.textContent = '&#9203; Загрузка...'; statusEl.className = 'api-status loading'; }
  if (currentProvider === 'groq') {
    if (!groqKey || groqKey.length < 20) {
      addDebugLog('&#10060; Groq ключ не вставлен', 'error');
      logToScreen('&#9888;&#65039; Введи Groq ключ!', 'error');
      if (statusEl) { statusEl.textContent = '&#9888;&#65039; Нужен ключ'; statusEl.className = 'api-status disconnected'; }
      return;
    }
    try {
      var response = await fetch(buildUrl(GROQ_MODELS_URL), { headers: {'Authorization': 'Bearer ' + groqKey} });
      if (response.ok) {
        var data = await response.json();
        var chatModels = (data.data || []).filter(function(m) {
          if (!m.id) return false;
          var id = m.id.toLowerCase();
          if (id.includes('guard') || id.includes('safety') || id.includes('embedding') || id.includes('whisper') || id.includes('stt') || id.includes('tts')) return false;
          var isKnownChat = id.includes('llama') || id.includes('mixtral') || id.includes('gemma') || id.includes('deepseek') || id.includes('qwen') || id.includes('mistral');
          return isKnownChat && m.context_window && m.context_window >= 2000;
        });
        chatModels.sort(function(a, b) {
          if (a.id.includes('70b') && !b.id.includes('70b')) return -1;
          if (!a.id.includes('70b') && b.id.includes('70b')) return 1;
          return a.id.localeCompare(b.id);
        });
        availableModels.groq = chatModels.map(function(m) {
          return { id: m.id, name: m.id + (m.context_window ? ' (' + Math.round(m.context_window/1024) + 'K)' : '') };
        });
        addDebugLog('&#9989; Загружено ' + availableModels.groq.length + ' моделей', 'success');
        logToScreen('&#9989; Загружено ' + availableModels.groq.length + ' моделей', 'success');
        if (statusEl) { statusEl.textContent = '&#9989; ' + availableModels.groq.length + ' моделей'; statusEl.className = 'api-status connected'; }
        populateModelSelect();
        var bigModel = availableModels.groq.find(function(m) { return m.id.indexOf('70b') !== -1 || m.id.indexOf('8b') !== -1; });
        if (bigModel) selectedModel = bigModel.id;
        else if (availableModels.groq.length > 0) selectedModel = availableModels.groq[0].id;
        document.getElementById('model-select').value = selectedModel;
        localStorage.setItem('pattern_ai_model', selectedModel);
      } else {
        addDebugLog('&#10060; Ошибка загрузки: ' + response.status, 'error');
        logToScreen('&#10060; Ошибка: ' + response.status, 'error');
      }
    } catch (e) {
      addDebugLog('&#10060; Исключение: ' + e.message, 'error');
      logToScreen('&#10060; Ошибка сети: ' + e.message, 'error');
    }
  } else {
    availableModels.hf = [
      { id: 'meta-llama/Llama-3.1-8B-Instruct', name: 'Llama 3.1 8B' },
      { id: 'meta-llama/Llama-3.1-70B-Instruct', name: 'Llama 3.1 70B' },
      { id: 'mistralai/Mixtral-8x7B-Instruct-v0.1', name: 'Mixtral 8x7B' }
    ];
    populateModelSelect();
    if (statusEl) { statusEl.textContent = '&#9989; 3 модели HF'; statusEl.className = 'api-status connected'; }
  }
}

