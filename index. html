// ============================================
// АНАЛИЗ ТЕКСТА (v8.5 - с капом штрафа 75%)
// ============================================
function analyzeText() {
  var query = document.getElementById('query').value.toLowerCase();
  if (!query) { document.getElementById('local-status').textContent = '⚠️ Введите текст'; return; }
  textLength = query.length;
  if (textLength < 50) document.getElementById('local-status').textContent = '⚠️ Текст слишком короткий (мин. 50 символов)';
  
  hallucinations = detectHallucinations(query);
  hallucinationPenalty = Math.min(0.75, hallucinations.length * 0.15);
  if (hallucinations.length > 0) {
    document.getElementById('warning-box').style.display = 'block';
    document.getElementById('warning-count').textContent = 'Обнаружено ' + hallucinations.length + ' признаков выдуманных фактов:';
    var listHtml = '';
    for (var i = 0; i < hallucinations.length; i++) listHtml += '<li><strong>' + hallucinations[i].marker + '</strong> (категория: ' + hallucinations[i].category + ')</li>';
    document.getElementById('warning-list').innerHTML = listHtml;
  } else { document.getElementById('warning-box').style.display = 'none'; }
  
  contradictions = detectContradictions(query);
  contradictionPenalty = contradictions.found ? 0.10 : 0;
  if (contradictions.found) {
    document.getElementById('contradiction-box').style.display = 'block';
    document.getElementById('contradiction-text').textContent = contradictions.message;
  } else { document.getElementById('contradiction-box').style.display = 'none'; }
  
  fluffMarkers = detectFluff(query);
  if (fluffMarkers.length <= 2) fluffPenalty = 0;
  else if (fluffMarkers.length <= 5) fluffPenalty = 0.10;
  else fluffPenalty = 0.20;
  if (fluffMarkers.length > 0) {
    document.getElementById('fluff-box').style.display = 'block';
    document.getElementById('fluff-text').textContent = 'Найдено ' + fluffMarkers.length + ' маркеров манипуляции: ' + fluffMarkers.slice(0, 5).join(', ') + '. Это снижает доверие к тексту.';
  } else { document.getElementById('fluff-box').style.display = 'none'; }
  
  var detected = detectDomain(query);
  switchDomain(detected);
  var dom = DOMAINS[currentDomain];
  uniqueMarkers = 0;
  for (var i = 0; i < CRITERIA.length; i++) {
    var posCount = 0, negCount = 0;
    var kw = dom.keywords[i];
    for (var j = 0; j < kw.pos.length; j++) { if (query.indexOf(kw.pos[j]) !== -1) { posCount++; uniqueMarkers++; } }
    for (var j = 0; j < kw.neg.length; j++) { if (query.indexOf(kw.neg[j]) !== -1) { negCount++; uniqueMarkers++; } }
    var rawScore = 0.5 + (posCount * 0.15) - (negCount * 0.25);
    vals[i] = Math.max(0.1, Math.min(0.95, rawScore));
    originalVals[i] = vals[i];
    document.getElementById('slider' + i).value = vals[i];
    document.getElementById('v' + i).textContent = vals[i].toFixed(2);
    document.getElementById('v' + i).classList.remove('changed');
    document.getElementById('slider' + i).classList.remove('changed');
    document.getElementById('crit-' + i).classList.remove('simulated');
  }
  isSimulation = false;
  var statusText = '✅ Анализ завершён. Галлюцинаций: ' + hallucinations.length;
  if (contradictions.found) statusText += ', Противоречий: 1';
  if (fluffMarkers.length > 0) statusText += ', "Воды": ' + fluffMarkers.length;
  document.getElementById('local-status').textContent = statusText;
  document.getElementById('res').style.display = 'none';
  document.getElementById('llm-result').style.display = 'none';
  document.getElementById('sim-badge').style.display = 'none';
  document.getElementById('reset-btn').style.display = 'none';
  document.getElementById('sc').classList.remove('simulated', 'penalty');
  document.getElementById('penalty-badge').style.display = 'none';
}

// ============================================
// ОЦЕНКА СИСТЕМЫ
// ============================================
function runEvaluate() {
  var dom = DOMAINS[currentDomain];
  var sc = calculateNonlinearScore(vals, dom.weights);
  var totalPenalty = hallucinationPenalty + contradictionPenalty + fluffPenalty;
  if (totalPenalty > 0) { sc = sc * (1 - totalPenalty); sc = Math.max(0.1, sc); }
  
  var bestScore = -1, best = null, bestMetrics = null;
  for (var j = 0; j < dom.archetypes.length; j++) {
    var metrics = combinedScore(vals, dom.archetypes[j].pattern, dom.weights);
    if (metrics.combined > bestScore) { bestScore = metrics.combined; best = dom.archetypes[j]; bestMetrics = metrics; }
  }
  
  if (hallucinations.length >= 2 && sc < 0.4) {
    if (currentDomain === 'science') {
      for (var j = 0; j < dom.archetypes.length; j++) {
        if (dom.archetypes[j].name === "Академический Мошенник") { best = dom.archetypes[j]; bestMetrics = combinedScore(vals, best.pattern, dom.weights); break; }
      }
    } else if (currentDomain === 'business') {
      for (var j = 0; j < dom.archetypes.length; j++) {
        if (dom.archetypes[j].name === "🎭 Фейковый Гуру") { best = dom.archetypes[j]; bestMetrics = combinedScore(vals, best.pattern, dom.weights); break; }
      }
    }
  }
  
  lastConfidence = { cosine: bestMetrics.cosine, euclidean: bestMetrics.euclidean, combined: bestMetrics.combined, archetype: best.name };
  document.getElementById('sc').textContent = sc.toFixed(2);
  document.getElementById('arch-name').textContent = best.name;
  document.getElementById('arch-desc').textContent = best.desc;
  var confText = 'Уверенность: ' + (bestMetrics.combined * 100).toFixed(1) + '% (косинус: ' + (bestMetrics.cosine * 100).toFixed(0) + '%, евклидово: ' + (bestMetrics.euclidean * 100).toFixed(0) + '%)';
  document.getElementById('confidence').textContent = confText;
  document.getElementById('res').style.display = 'block';
  document.getElementById('llm-result').style.display = 'none';
  
  document.getElementById('metric-confidence').textContent = 'Уверенность: ' + (bestMetrics.combined * 100).toFixed(1) + '%';
  document.getElementById('metric-textlen').textContent = 'Длина текста: ' + textLength + ' символов';
  document.getElementById('metric-unique').textContent = 'Уникальных маркеров: ' + uniqueMarkers;
  var fluffLevel = fluffMarkers.length === 0 ? 'Низкий' : (fluffMarkers.length < 3 ? 'Средний' : 'Высокий');
  document.getElementById('metric-fluff').textContent = 'Уровень "воды": ' + fluffLevel;
  
  if (totalPenalty > 0) {
    var penaltyText = '⚠️ Штрафы: ';
    var parts = [];
    if (hallucinationPenalty > 0) parts.push('-' + (hallucinationPenalty * 100).toFixed(0) + '% за выдумки (' + hallucinations.length + ' марк.)');
    if (contradictionPenalty > 0) parts.push('-10% за противоречия');
    if (fluffPenalty > 0) parts.push('-' + (fluffPenalty * 100).toFixed(0) + '% за "воду"');
    document.getElementById('penalty-badge').textContent = penaltyText + parts.join(', ');
    document.getElementById('penalty-badge').style.display = 'block';
    document.getElementById('sc').classList.add('penalty');
  } else {
    document.getElementById('penalty-badge').style.display = 'none';
    document.getElementById('sc').classList.remove('penalty');
  }
  
  if (isSimulation) {
    document.getElementById('sim-badge').style.display = 'block';
    document.getElementById('reset-btn').style.display = 'block';
    document.getElementById('sc').classList.add('simulated');
  } else {
    document.getElementById('sim-badge').style.display = 'none';
    document.getElementById('reset-btn').style.display = 'none';
    document.getElementById('sc').classList.remove('simulated');
  }
  document.getElementById('res').scrollIntoView({behavior: 'smooth'});
}

// ============================================
// ЛОКАЛЬНЫЙ АНАЛИЗ
// ============================================
function getLocalAnalysis() {
  var dom = DOMAINS[currentDomain];
  var sc = parseFloat(document.getElementById('sc').textContent);
  var archName = document.getElementById('arch-name').textContent;
  var archDesc = document.getElementById('arch-desc').textContent;
  var sorted = [];
  for (var i = 0; i < CRITERIA.length; i++) { sorted.push({name: CRITERIA[i].n, val: vals[i], w: dom.weights[i], desc: dom.descriptions[i]}); }
  sorted.sort(function(a, b) { return a.val - b.val; });
  var weakest = sorted[0], secondWeak = sorted[1];
  var text = '📊 СОСТОЯНИЕ СИСТЕМЫ (v8.5)\n━━━━━━━━━━━━━━━━━━━━━\n';
  text += 'Сфера: ' + dom.name + '\nОбщий балл: ' + sc.toFixed(2) + ' из 1.00\n';
  text += 'Длина текста: ' + textLength + ' символов\n';
  text += 'Уникальных маркеров: ' + uniqueMarkers + '\n\n';
  text += 'Архетип: ' + archName + ' (Уверенность: ' + (lastConfidence.combined * 100).toFixed(1) + '%)\n' + archDesc + '\n\n';
  text += '⚠️ ГЛАВНЫЕ УЯЗВИМОСТИ\n━━━━━━━━━━━━━━━━━━━━━\n';
  if (sc < 0.4 || weakest.val < 0.5) {
    text += '1. ' + weakest.name + ' (оценка: ' + weakest.val.toFixed(2) + ')\n';
    text += '   Описание: ' + weakest.desc + '\n   Вес фактора: ' + weakest.w + ' — ';
    if (weakest.w >= 0.15) text += 'ВЫСОКИЙ, это критично!\n';
    else if (weakest.w >= 0.10) text += 'средний, требует внимания.\n';
    else text += 'низкий, но влияет.\n';
    text += '   Потеря потенциала: ' + ((1 - weakest.val) * weakest.w * 100).toFixed(1) + '%\n\n';
    if (secondWeak.val < 0.5 && secondWeak.name !== weakest.name) {
      text += '2. ' + secondWeak.name + ' (оценка: ' + secondWeak.val.toFixed(2) + ')\n';
      text += '   Описание: ' + secondWeak.desc + '\n   Усиливает первую проблему.\n\n';
    }
  } else { text += 'Критических уязвимостей нет. Все параметры выше 0.5.\n\n'; }
  text += '💡 КОНКРЕТНЫЕ ШАГИ\n━━━━━━━━━━━━━━━━━━━━━\n';
  text += '📌 По архетипу (' + archName + '):\n' + (dom.archRecs[archName] || dom.archRecs['Переходное состояние']) + '\n\n';
  if (hallucinations.length > 0) text += '🚫 Найдено ' + hallucinations.length + ' галлюцинаций. Проверьте факты.\n';
  if (contradictions.found) text += '🔀 Обнаружены логические противоречия.\n';
  if (fluffMarkers.length > 0) text += '💨 Высокий уровень "воды". Будьте конкретнее.\n';
  return text;
}

