  uniqueMarkers = 0;
  for (var i = 0; i < CRITERIA.length; i++) {
    var posCount = 0, negCount = 0;
    var kw = dom.keywords[i];
    for (var j = 0; j < kw.pos.length; j++) { if (query.indexOf(kw.pos[j]) !== -1) { posCount++; uniqueMarkers++; } }
    for (var j = 0; j < kw.neg.length; j++) { if (query.indexOf(kw.neg[j]) !== -1) { negCount++; uniqueMarkers++; } }
    var rawScore = 0.5 + (posCount * 0.15) - (negCount * 0.25);
    vals[i] = Math.max(0.1, Math.min(0.95, rawScore));
    originalVals[i] = vals[i];
    document.getElementById('slider' + i).value = vals[i];
    document.getElementById('v' + i).textContent = vals[i].toFixed(2);
  }
  isSimulation = false;
  
  // 2. LLM анализ
  llmResult = null;
  llmPenalty = 0;
  document.getElementById('llm-analysis-box').style.display = 'none';
  
  try {
    llmResult = await analyzeWithLLM(document.getElementById('query').value);
  } catch (e) {
    logToScreen('❌ Ошибка LLM: ' + e.message, 'error');
  }
  
  // 3. Обработка LLM результата
  if (llmResult) {
    document.getElementById('llm-analysis-box').style.display = 'block';
    document.getElementById('llm-domain').textContent = llmResult.domain || 'не определена';
    document.getElementById('llm-facts').textContent = JSON.stringify(llmResult.structural_facts || {}, null, 2);
    document.getElementById('llm-contradictions').textContent = (llmResult.contradictions || []).join('; ') || 'не обнаружены';
    document.getElementById('llm-suspicious').textContent = (llmResult.suspicious_claims || []).join('; ') || 'не обнаружены';
    
    var llmContradictions = llmResult.contradictions || [];
    var llmSuspicious = llmResult.suspicious_claims || [];
    var llmManipulative = llmResult.manipulative_language || [];
    
    llmPenalty = (llmContradictions.length * 0.05) + (llmSuspicious.length * 0.05) + (llmManipulative.length * 0.03);
    llmPenalty = Math.min(0.30, llmPenalty);
    
    if (llmContradictions.length > 0 && !contradictions.found) {
      contradictions = { found: true, posMarkers: [], negMarkers: [], message: 'LLM обнаружил: ' + llmContradictions.join('; ') };
      contradictionPenalty = 0.10;
      document.getElementById('contradiction-box').style.display = 'block';
      document.getElementById('contradiction-text').textContent = contradictions.message;
    }
    
    if (llmResult.domain && llmResult.domain !== currentDomain && DOMAINS[llmResult.domain]) {
      switchDomain(llmResult.domain);
    }
    
    logToScreen('✅ Анализ завершён. LLM: ✅', 'success');
  } else {
    logToScreen('✅ Анализ завершён (локально). LLM недоступен.', 'info');
  }
  
  document.getElementById('loading').classList.remove('active');
  document.getElementById('res').style.display = 'none';
  document.getElementById('llm-result').style.display = 'none';
  document.getElementById('penalty-badge').style.display = 'none';
  
  runEvaluate();
}

