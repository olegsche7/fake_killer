function logToScreen(message, type) {
  type = type || 'info';
  var statusEl = document.getElementById('local-status');
  if (statusEl) {
    statusEl.textContent = message;
    if (type === 'error') { statusEl.style.color = '#F44336'; statusEl.style.background = 'rgba(244,67,54,0.1)'; }
    else if (type === 'success') { statusEl.style.color = '#4CAF50'; statusEl.style.background = 'rgba(76,175,80,0.1)'; }
    else if (type === 'warning') { statusEl.style.color = '#ff9800'; statusEl.style.background = 'rgba(255,152,0,0.1)'; }
    else { statusEl.style.color = '#00d2ff'; statusEl.style.background = 'transparent'; }
