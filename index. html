        abstractPatterns.push(pattern);
        try {
            localStorage.setItem('pattern_ai_abstract_patterns', JSON.stringify(abstractPatterns));
            updateMemoryDisplay();
        } catch (e) { return false; }
        cloudLog('&#9729;&#65039; Отправка: "' + pattern.rule + '"...', 'info');
        try {
            var response = await fetch(CLOUD_API + '/patterns-add', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    rule: pattern.rule,
                    description: pattern.description || 'Нет описания',
                    category: pattern.category || 'logic',
                    source: 'hf-v15.0-auto'
                })
            });
