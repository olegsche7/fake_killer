// ============================================
// МАТЕМАТИКА
// ============================================
function cosineSimilarity(vecA, vecB, weights) {
  var dotProduct = 0, magnitudeA = 0, magnitudeB = 0;
  for (var i = 0; i < vecA.length; i++) {
    var w = weights[i] || 1;
    var a = vecA[i] * w, b = vecB[i] * w;
    dotProduct += a * b; magnitudeA += a * a; magnitudeB += b * b;
  }
  magnitudeA = Math.sqrt(magnitudeA); magnitudeB = Math.sqrt(magnitudeB);
  if (magnitudeA === 0 || magnitudeB === 0) return 0;
  return dotProduct / (magnitudeA * magnitudeB);
}

function normalizedEuclideanDistance(vecA, vecB, weights) {
  var sum = 0, maxPossible = 0;
  for (var i = 0; i < vecA.length; i++) {
    var w = weights[i] || 1;
    var diff = (vecA[i] - vecB[i]) * w;
    sum += diff * diff; maxPossible += w * w;
  }
  var distance = Math.sqrt(sum);
  var maxDistance = Math.sqrt(maxPossible);
  if (maxDistance === 0) return 0;
  return distance / maxDistance;
}

function combinedScore(vecA, vecB, weights) {
  var cosSim = cosineSimilarity(vecA, vecB, weights);
  var eucDist = normalizedEuclideanDistance(vecA, vecB, weights);
  return { combined: 0.6 * cosSim + 0.4 * (1 - eucDist), cosine: cosSim, euclidean: 1 - eucDist };
}

function sigmoid(x) { return 1 / (1 + Math.exp(-6 * (x - 0.5))); }

function calculateNonlinearScore(vals, weights) {
  var baseScore = 0;
  for (var i = 0; i < vals.length; i++) baseScore += vals[i] * weights[i];
  var nonlinearScore = sigmoid(baseScore);
  var criticalPairs = [[3, 0], [3, 8], [1, 7]];
  var penalty = 1.0;
  for (var p = 0; p < criticalPairs.length; p++) {
    if (vals[criticalPairs[p][0]] < 0.3 && vals[criticalPairs[p][1]] < 0.3) penalty *= 0.7;
  }
  return nonlinearScore * penalty;
}

