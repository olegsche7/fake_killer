import { Redis } from '@upstash/redis';

const redis = new Redis({
  url: process.env.UPSTASH_URL,
  token: process.env.UPSTASH_TOKEN
});

export default async function handler(req, res) {
  res.setHeader('Access-Control-Allow-Origin', '*');
  res.setHeader('Access-Control-Allow-Methods', 'POST, OPTIONS');
  res.setHeader('Access-Control-Allow-Headers', 'Content-Type');
  
  if (req.method === 'OPTIONS') {
    return res.status(200).end();
  }
  
  if (req.method !== 'POST') {
    return res.status(405).json({ error: 'Method not allowed' });
  }

  const { rule, description, category, source } = req.body;

  if (!rule || !description || !category) {
    return res.status(400).json({ error: 'Missing required fields: rule, description, category' });
  }

  const validCategories = ['scale_gap', 'semantic_void', 'role_overlap', 'fake_authority', 'logic'];
  if (!validCategories.includes(category)) {
    return res.status(400).json({ 
      error: `Invalid category. Must be one of: ${validCategories.join(', ')}` 
    });
  }

  try {
    const key = `pattern:${rule}`;
    const exists = await redis.exists(key);
    
    if (exists) {
      return res.status(409).json({ error: 'Pattern already exists' });
    }

    await redis.set(key, JSON.stringify({
      rule,
      description,
      category,
      source: source || 'manual',
      createdAt: new Date().toISOString(),
      approved: true
    }));

    return res.status(200).json({ success: true, message: 'Pattern added' });

  } catch (error) {
    console.error('Add pattern error:', error);
    return res.status(500).json({ error: error.message });
  }
}
