import { Redis } from '@upstash/redis';

const redis = new Redis({
  url: process.env.UPSTASH_URL,
  token: process.env.UPSTASH_TOKEN
});

export default async function handler(req, res) {
  // Разрешаем CORS для локальной разработки
  res.setHeader('Access-Control-Allow-Origin', '*');
  res.setHeader('Access-Control-Allow-Methods', 'POST, OPTIONS');
  res.setHeader('Access-Control-Allow-Headers', 'Content-Type');
  
  if (req.method === 'OPTIONS') {
    return res.status(200).end();
  }
  
  if (req.method !== 'POST') {
    return res.status(405).json({ error: 'Method not allowed' });
  }

  const { text, apiKey, model = 'qwen/qwen3.8-27b' } = req.body;

  if (!text || !apiKey) {
    return res.status(400).json({ error: 'Missing text or apiKey' });
  }

  const systemPrompt = `Ты — эксперт по структурному анализу текстов и когнитивным искажениям.
Твоя задача — найти в тексте скрытые паттерны манипуляции, логические ошибки или структурные искажения.

Проанализируй текст и извлеки от 1 до 3 абстрактных паттернов.

Strict Rules:
1. Формулируй rule как универсальное правило (2-4 слова), а не описание конкретного случая.
2. category должна быть ОДНОЙ из: scale_gap, semantic_void, role_overlap, fake_authority, logic.
3. Возвращай СТРОГО JSON-объект с ключом "patterns", содержащим массив.

JSON Format (строго этот формат, ничего больше):
{"patterns": [{"rule": "Название", "description": "Описание", "category": "категория"}]}`;

  try {
    const response = await fetch('https://api.groq.com/openai/v1/chat/completions', {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${apiKey}`,
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        model: model,
        messages: [
          { role: 'system', content: systemPrompt },
          { role: 'user', content: `Text: ${text.substring(0, 2000)}` }
        ],
        temperature: 0.1,
        response_format: { type: 'json_object' },
        max_tokens: 800
      })
    });

    if (!response.ok) {
      const errText = await response.text();
      return res.status(response.status).json({ error: `LLM error: ${errText}` });
    }

    const data = await response.json();
    const content = data.choices?.[0]?.message?.content;
    
    if (!content) {
      return res.status(500).json({ error: 'Empty response from LLM' });
    }

    let parsed;
    try {
      parsed = JSON.parse(content);
    } catch (e) {
      return res.status(500).json({ error: 'Invalid JSON from LLM', raw: content });
    }

    const patterns = parsed.patterns || [];
    const saved = [];

    // Сохраняем только новые паттерны
    for (const pattern of patterns) {
      if (!pattern.rule || !pattern.description || !pattern.category) continue;
      
      const key = `pattern:${pattern.rule}`;
      const exists = await redis.exists(key);
      
      if (!exists) {
        await redis.set(key, JSON.stringify({
          rule: pattern.rule,
          description: pattern.description,
          category: pattern.category,
          source: text.substring(0, 80) + '...',
          createdAt: new Date().toISOString(),
          approved: false
        }));
        saved.push(pattern);
      }
    }

    return res.status(200).json({ 
      success: true, 
      patterns: patterns,
      saved: saved.length,
      total: patterns.length
    });

  } catch (error) {
    console.error('Mining error:', error);
    return res.status(500).json({ error: error.message });
  }
}
